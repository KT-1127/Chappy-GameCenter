rules_version = '2';
// チャッピーGameセンター 用の Firestore ルール
//   生徒   : 匿名ログイン。自分の記録だけ作れる／ベストを更新できる（OFF のゲームは不可）
//   管理者 : メール＋パスワードでログインし、cgc_admins/{uid} があること。設定の変更・記録の編集/削除ができる
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/cgc_admins/$(request.auth.uid));
    }
    function gameOn(g) {
      let p = /databases/$(database)/documents/cgc_settings/main;
      return !exists(p) || get(p).data.get('games', {}).get(g, true) != false;
    }
    function validScore(id) {
      let d = request.resource.data;
      return d.keys().hasOnly(['game', 'board', 'boardName', 'nick', 'score', 'order', 'uid', 'date', 'ts'])
        && d.game in ['link', 'cannon', 'ringo', 'paku', 'rhythm', 'home', 'sagashi']
        && d.board is string && d.board.matches('^[A-Za-z0-9-]{1,60}$')
        && d.boardName is string && d.boardName.size() <= 60
        && d.nick is string && d.nick.size() >= 1 && d.nick.size() <= 10
        && d.score is number && d.score > -10000000000 && d.score < 10000000000
        && d.order in ['asc', 'desc']
        && d.date is string && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d.ts is int
        && d.uid == request.auth.uid
        && id == d.uid + '_' + d.date + '_' + d.game + '_' + d.board
        && gameOn(d.game);
    }
    function improved() {
      let n = request.resource.data;
      let o = resource.data;
      return n.order == o.order
        && ((n.order == 'desc' && n.score > o.score) || (n.order == 'asc' && n.score < o.score));
    }

    match /cgc_settings/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /cgc_admins/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false; // Firebase コンソールで作る
    }

    match /cgc_scores/{id} {
      allow read: if true;
      allow create: if isAdmin() || (signedIn() && validScore(id));
      allow update: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid && validScore(id) && improved());
      allow delete: if isAdmin();
    }
  }
}
